# Copia este archivo a .env.production y sustituye todos los valores CHANGE_ME.
# Usa una contraseña larga que solo contenga caracteres seguros para una URL.
POSTGRES_DB=gestor_finanzas
POSTGRES_USER=gestor_finanzas
POSTGRES_PASSWORD=CHANGE_ME_USE_A_LONG_RANDOM_PASSWORD
DATABASE_URL=postgres://gestor_finanzas:CHANGE_ME_USE_A_LONG_RANDOM_PASSWORD@postgres:5432/gestor_finanzas

# Solo se publica en loopback. Un reverse proxy local puede exponer HTTPS.
APP_PORT=3210

# Autenticación. ADMIN_PASSWORD_HASH se genera con:
#   node scripts/hash-password.mts <contraseña>
# SESSION_SECRET se genera con: openssl rand -hex 32
# Debe ser idéntico para api y web: firma y verifica la misma cookie.
ADMIN_USERNAME=CHANGE_ME
ADMIN_PASSWORD_HASH=CHANGE_ME_RUN_scripts/hash-password.mts
SESSION_SECRET=CHANGE_ME_USE_A_LONG_RANDOM_SECRET
